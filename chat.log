    7 │                                                                                              
    8 │                                                                                              
    9 │ class TestHelloCLI(unittest.TestCase):                                                       
   10 │     def test_default_name(self):                                                             
   11 │         result = subprocess.run(                                                             
   12 │             [sys.executable, HELLO_PATH],                                                    
   13 │             capture_output=True, text=True,                                                  
   14 │         )                                                                                    
   15 │         self.assertEqual(result.returncode, 0)                                               
   16 │         self.assertEqual(result.stdout.strip(), "Hello, World!")                             
   17 │                                                                                              
   18 │     def test_custom_name(self):                                                              
   19 │         result = subprocess.run(                                                             
   20 │             [sys.executable, HELLO_PATH, "--name", "Alice"],                                 
   21 │             capture_output=True, text=True,                                                  
   22 │         )                                                                                    
   23 │         self.assertEqual(result.returncode, 0)                                               
   24 │         self.assertEqual(result.stdout.strip(), "Hello, Alice!")                             
   25 │                                                                                              
   26 │                                                                                              
   27 │ if __name__ == "__main__":                                                                   
   28 │     unittest.main()                                                                          
   
   Subprocess-based end-to-end tests matching the test_interface spec. Uses sys.executable for 
   portability and os.path for reliable path resolution.
   
   Guidelines
   
     ◦ Use subprocess.run with capture_output=True and text=True for process invocation
     ◦ Use sys.executable to get the current Python interpreter path — do not hardcode 'python' or
       'python3'
     ◦ Strip stdout before comparison to handle trailing newlines portably
     ◦ Resolve the path to hello.py relative to the test file using os.path or pathlib, not 
       hardcoded relative paths

